server:
  port: 8080
  base_url: https://later.domain.com # used as the callback url on notification action buttons https://docs.ntfy.sh/publish/#send-http-request
  data_dir: ./data # path for the reminder data files

ntfy:
  server: https://ntfy.domain.com # used as the server for your ntfy
  token: tk_XXXXX # your ntfy token with the appropriate permissions, for example later*:rw

inbound:
  - topic: later-input-user # topic that later listens to for reminders
    outbound: # required: topic(s) that get the reminders set via this inbound topic
      - later-reminders-user

auth_tokens:
  - token: tk_replace_this_with_a_real_token_at_least_16_chars # generate via `ntfy token generate`
    outbound: # required: outbound topics this token is allowed to set reminders for
      - later-reminders-user
    # default_outbound: later-reminders-user # optional: where reminders without explicit topics go. Without it they fan out to ALL outbound topics above. Must be one of them

late_prefix: "DELAYED:" # gets prepended to messages that get sent after a downtime of later